# Copy these names into Netlify → Site configuration → Environment variables.
# NEVER commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
PAYLOAD_SECRET=long-random-string-at-least-32-characters
S3_BUCKET=media
S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
